---
import { site } from '../site.config';
import Icon from './Icon.astro';
const h = site.hero;
// Place orbit nodes evenly on a circle (percent coordinates inside the square visual)
const nodes = h.orbit.map((name, i) => {
  const a = (i / h.orbit.length) * Math.PI * 2 - Math.PI / 2;
  return { name, x: 50 + Math.cos(a) * 42, y: 50 + Math.sin(a) * 42, delay: i * 0.35 };
});
---
<section class="hero">
  <div class="grid-bg"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      {h.badge && (
        <a class="hero__badge reveal" href={h.badge.link?.href ?? '#'}>
          <span class="dot"></span>{h.badge.text}
          {h.badge.link && <span class="hero__badge-link">{h.badge.link.label} <Icon name="arrow" class="icon xs" /></span>}
        </a>
      )}
      <h1 class="hero__title reveal">
        {h.titleLines.map((line, i) => <span class={h.highlightLines.includes(i) ? 'accent' : ''}>{line}</span>)}
      </h1>
      <p class="hero__lead reveal" set:html={h.lead} />
      <div class="hero__actions reveal">
        <a class="btn btn--primary" href={h.primary.href}>{h.primary.label} <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={h.secondary.href}>{h.secondary.label}</a>
      </div>
      <ul class="hero__points reveal">
        {h.points.map((p) => <li><Icon name="check" class="icon xs" />{p}</li>)}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <svg class="hero__lines" viewBox="0 0 100 100" preserveAspectRatio="none">
        {nodes.map((n) => <line x1="50" y1="50" x2={n.x} y2={n.y} />)}
      </svg>
      <div class="hero__ring r1"></div><div class="hero__ring r2"></div>
      <div class="hero__core"><img src={site.logo} alt="" width="96" height="96" /></div>
      {nodes.map((n) => (
        <div class="hero__node" style={`left:${n.x}%;top:${n.y}%;animation-delay:${n.delay}s`}>
          <Icon name={n.name} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(48px, 8vw, 96px) clamp(72px, 10vw, 120px); }
  .hero__glow { position: absolute; inset: -20% -10% auto auto; width: 70vw; height: 70vw; background: radial-gradient(circle, var(--accent-soft), transparent 60%); z-index: -1; }
  .hero__inner { display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: center; }
  .hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px; border-radius: var(--r-pill); background: var(--surface-2); border: 1px solid var(--line-soft); font-size: var(--t-sm); font-weight: 600; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .hero__badge-link { display: inline-flex; align-items: center; gap: 4px; padding-left: 10px; border-left: 1px solid var(--line); color: var(--accent-strong); }
  :global(.xs) { width: 14px; height: 14px; }
  .hero__title { font-size: var(--t-hero); margin-top: 28px; letter-spacing: -0.05em; line-height: 0.98; }
  .hero__title span { display: block; }
  .hero__lead { font-size: var(--t-lead); color: var(--text-2); max-width: 540px; margin-top: 28px; }
  .hero__lead :global(strong) { color: var(--text); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero__points { display: flex; flex-wrap: wrap; gap: 10px 24px; list-style: none; padding: 0; margin: 40px 0 0; font-size: var(--t-sm); color: var(--text-2); }
  .hero__points li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__points :global(svg) { color: var(--accent-strong); }
  .hero__copy .reveal:nth-child(2) { transition-delay: 80ms; } .hero__copy .reveal:nth-child(3) { transition-delay: 160ms; }
  .hero__copy .reveal:nth-child(4) { transition-delay: 240ms; } .hero__copy .reveal:nth-child(5) { transition-delay: 320ms; }

  .hero__visual { position: relative; aspect-ratio: 1; width: 100%; max-width: 520px; justify-self: center; }
  .hero__lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hero__lines line { stroke: var(--accent); stroke-opacity: 0.55; vector-effect: non-scaling-stroke; animation: flow 3s linear infinite; }
  .hero__lines line { stroke-width: 1.5; stroke-dasharray: 6 6; }
  @keyframes flow { to { stroke-dashoffset: -24; } }
  .hero__ring { position: absolute; left: 50%; top: 50%; border-radius: 50%; border: 1px solid var(--accent-line); transform: translate(-50%, -50%); }
  .r1 { width: 44%; height: 44%; animation: pulse 4s var(--ease) infinite; }
  .r2 { width: 60%; height: 60%; animation: pulse 4s var(--ease) 1s infinite; opacity: 0.6; }
  @keyframes pulse { 0%,100% { transform: translate(-50%,-50%) scale(1); } 50% { transform: translate(-50%,-50%) scale(1.05); } }
  .hero__core { position: absolute; left: 50%; top: 50%; width: 30%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; display: grid; place-items: center; background: var(--surface); box-shadow: 0 0 0 10px var(--accent-soft), 0 20px 60px var(--accent-line); }
  .hero__core img { width: 62%; height: auto; }
  .hero__node { position: absolute; width: 52px; height: 52px; transform: translate(-50%, -50%); display: grid; place-items: center; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line-soft); box-shadow: var(--shadow); color: var(--text-2); animation: float 5s ease-in-out infinite; }
  .hero__node::after { content: ''; position: absolute; top: 6px; right: 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  @keyframes float { 0%,100% { translate: 0 0; } 50% { translate: 0 -8px; } }
  @media (max-width: 900px) { .hero__inner { grid-template-columns: 1fr; } .hero__visual { display: none; } }
</style>
