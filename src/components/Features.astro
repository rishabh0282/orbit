---
import { site } from '../site.config';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
const f = site.features;
---
<section class="section" id="features">
  <div class="container">
    <SectionHead eyebrow={f.eyebrow} title={f.title} lead={f.lead} />
    <div class="features">
      {f.items.map((item, i) => (
        <article class="feature reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
          <div class="feature__icon"><Icon name={item.icon} /></div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .features { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line-soft); border-radius: var(--r-lg); overflow: hidden; background: var(--line-soft); gap: 1px; }
  .feature { background: var(--bg); padding: 36px 32px; transition: background var(--fast); }
  .feature:hover { background: var(--surface-2); }
  .feature__icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--r-md); background: var(--accent-soft); color: var(--accent-strong); margin-bottom: 22px; }
  .feature h3 { font-size: 1.0625rem; letter-spacing: -0.01em; font-weight: 700; }
  .feature p { color: var(--text-2); margin-top: 8px; font-size: 0.9375rem; }
  @media (max-width: 900px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .features { grid-template-columns: 1fr; } }
</style>
