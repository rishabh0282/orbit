---
import { site } from '../site.config';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
const c = site.compare;
---
<section class="section section--alt" id="compare">
  <div class="container">
    <SectionHead eyebrow={c.eyebrow} title={c.title} center />
    <div class="table-wrap reveal">
      <table>
        <thead><tr><th></th>{c.columns.map((col, i) => <th class:list={{ hl: i === c.highlight }}>{col}</th>)}</tr></thead>
        <tbody>
          {c.rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {r.values.map((v, i) => (
                <td class:list={{ hl: i === c.highlight }}>
                  {v === true ? <span class="yes"><Icon name="check" /><span class="sr">Yes</span></span>
                    : v === false ? <span class="no"><Icon name="x" /><span class="sr">No</span></span> : v}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
<style>
  .table-wrap { max-width: 880px; margin-inline: auto; overflow-x: auto; background: var(--bg); border: 1px solid var(--line-soft); border-radius: var(--r-lg); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  th, td { padding: 18px 22px; text-align: center; border-bottom: 1px solid var(--line-soft); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  thead th { font: 600 var(--t-xs)/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3); }
  tbody th { text-align: left; font-weight: 600; }
  .hl { background: var(--accent-soft); color: var(--text); }
  thead .hl { color: var(--accent-strong); }
  .yes { color: var(--accent-strong); display: inline-grid; } .no { color: var(--text-3); display: inline-grid; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
